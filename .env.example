# Elastic Cloud: deployment endpoint + API key (Kibana > Stack Management > API keys)
ELASTIC_URL=https://xxxx.es.us-central1.gcp.cloud.es.io:443
ELASTIC_API_KEY=

# Dash0 backend (Settings > Endpoints, Settings > Auth Tokens)
OTEL_SERVICE_NAME=dex-api
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingress.us-west-2.aws.dash0.com
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer YOUR_TOKEN,Dash0-Dataset=default
OTEL_LOGS_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp

# Dash0 browser RUM: a SEPARATE ingest-only token (it is public in the browser)
DASH0_WEB_ENDPOINT=https://ingress.us-west-2.aws.dash0.com
DASH0_WEB_TOKEN=

# Event Pulse reads API health live from Dash0, and `pnpm obs:apply` pushes observability/ (dashboard, SLO, check rule).
# Token needs "All permissions"; if unset, the bearer token in OTEL_EXPORTER_OTLP_HEADERS is used.
DASH0_API_URL=https://api.us-west-2.aws.dash0.com
DASH0_API_TOKEN=
DASH0_DATASET=default
# Printed by `pnpm obs:apply`; shown as the "open in Dash0" link on the pulse
DASH0_DASHBOARD_URL=

# Shown in the app (GET /api/config)
EVENT_NAME=Cloud Native Hackathon
EVENT_ENDS_AT=2026-11-09T18:30:00-07:00

OPENAI_API_KEY=

# Booth staff enter this at signup to get a sponsor account
SPONSOR_CODE=

# Skip cloud metadata probes (we are not on GCP/AWS VMs); K8s attrs come from OTEL_RESOURCE_ATTRIBUTES
OTEL_NODE_RESOURCE_DETECTORS=env,host,os,process,serviceinstance
