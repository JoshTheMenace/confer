{
  "name": "@dex/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env --import ./src/otel.ts src/index.ts",
    "build": "tsc",
    "start": "node --import ./dist/otel.js dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx --env-file=../../.env src/seed.ts"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^9.5.1",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.0",
    "@opentelemetry/instrumentation": "^0.301.1",
    "hono": "^4.13.17",
    "openai": "^7.54.0",
    "openlit": "^1.15.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "files": [
    "dist"
  ]
}
